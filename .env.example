# Copy this file to .env and fill in the token. .env is ignored by git.
# Every value here is a secret: never commit one, log it, or paste it into a chat.
DISCORD_BOT_TOKEN=

# The memory service. Leave empty if your Hindsight runs with no API key.
HINDSIGHT_API_KEY=

# Search services. Each is optional: one with no key is passed over.
BRAVE_API_KEY=
TAVILY_API_KEY=

# GIFs come from Klipy first, then Giphy. Each is optional: with neither she posts no GIFs.
# A Klipy test key allows 100 searches an hour; past that, Giphy answers.
KLIPY_API_KEY=
GIPHY_API_KEY=
